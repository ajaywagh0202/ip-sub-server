let fakeTimer    = null;
let logOffset    = 0;
let fakeProgress = 0;

function setDot(state) { document.getElementById('status-dot').className = state; }

async function startScan() {
  if (!selectedAgentId) { alert('Please select a client PC first.'); return; }

  const btn = document.getElementById('scan-btn');
  btn.disabled = true;
  btn.textContent = '⏳ Scanning…';

  document.getElementById('log').textContent = '';
  document.getElementById('result-banner').classList.remove('visible');
  document.getElementById('dl-pdf').style.display  = 'none';
  document.getElementById('dl-json').style.display = 'none';
  document.getElementById('status-msg').textContent = 'Scan running on client PC…';
  document.getElementById('prog-label').textContent = 'Scanning…';
  document.getElementById('prog-bar').value = 2;
  logOffset = 0; fakeProgress = 2;
  setDot('scanning');

  clearInterval(fakeTimer);
  fakeTimer = setInterval(() => {
    if (fakeProgress < 92) { fakeProgress += 0.3; document.getElementById('prog-bar').value = fakeProgress; }
  }, 350);

  try {
    const d = await fetch(`/api/scan_client/${selectedAgentId}`, { method: 'POST' }).then(r => r.json());
    if (d.error) { onScanError(d.error); return; }
    clearInterval(pollTimer);
    pollTimer = setInterval(pollClientLog, 1200);
  } catch(e) { onScanError(String(e)); }
}

function appendLog(lines) {
  const el = document.getElementById('log');
  lines.forEach(line => {
    const span = document.createElement('span');
    if      (/\[ERROR\]|Scan failed/i.test(line)) span.className = 'log-err';
    else if (/Done\.|complete|PDF saved|JSON saved|Uploaded/i.test(line)) span.className = 'log-ok';
    else if (/={5,}/.test(line)) span.className = 'log-head';
    else if (/WARNING|warn/i.test(line)) span.className = 'log-warn';
    span.textContent = line + '\n';
    el.appendChild(span);
  });
  el.scrollTop = el.scrollHeight;
}

function pollClientLog() {
  fetch(`/api/client_status/${selectedAgentId}?offset=${logOffset}`)
    .then(r => r.json())
    .then(d => {
      if (d.lines && d.lines.length) {
        appendLog(d.lines);
        logOffset += d.lines.length;
      }
      if (d.status === 'done' || d.status === 'error') {
        clearInterval(pollTimer);
        clearInterval(fakeTimer);
        setTimeout(() => fetchClientResult(selectedAgentId), 800);
      }
    })
    .catch(() => {});
}

async function fetchClientResult(agentId) {
  try {
    const d = await fetch(`/api/client_result/${agentId}`).then(r => r.json());
    onScanDone(d, agentId);
  } catch(e) { onScanError(String(e)); }
}

function onScanDone(d, agentId) {
  const btn = document.getElementById('scan-btn');
  btn.disabled = false;
  btn.textContent = '▶ Scan This PC';
  document.getElementById('prog-bar').value = 100;

  if (d.error) { onScanError(d.error); return; }
  if (!d.pdf_name) { onScanError('Scan did not produce a report.'); return; }

  setDot('done');
  document.getElementById('prog-label').textContent = '✓ Scan complete';
  document.getElementById('status-msg').textContent = 'Scan complete — download your report below.';
  document.getElementById('result-text').textContent = `✓  Report ready: ${d.pdf_name}`;

  document.getElementById('dl-pdf').href  = `/api/client_download/${agentId}/pdf`;
  document.getElementById('dl-json').href = `/api/client_download/${agentId}/json`;
  document.getElementById('dl-pdf').style.display  = '';
  document.getElementById('dl-json').style.display = '';
  document.getElementById('result-banner').classList.add('visible');
}

function onScanError(msg) {
  clearInterval(fakeTimer); clearInterval(pollTimer);
  document.getElementById('prog-bar').value = 0;
  document.getElementById('prog-label').textContent = 'Scan failed — see log above';
  document.getElementById('status-msg').textContent = 'Error: ' + msg;
  const btn = document.getElementById('scan-btn');
  btn.disabled = false;
  btn.textContent = '▶ Scan This PC';
  setDot('error');
}
</script>
