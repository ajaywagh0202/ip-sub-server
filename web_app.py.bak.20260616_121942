@app.route("/api/info")
def api_info():
    import platform
    return jsonify({
        "hostname": socket.gethostname(),
        "ip":       _get_local_ip(),
        "os":       f"{platform.system()} {platform.release()}",
        "arch":     platform.machine(),
    })


@app.route("/api/my_ip")
def api_my_ip():
    """Return the IP address of whoever is calling this endpoint (the browser's PC)."""
    # X-Forwarded-For is set by proxies; for direct LAN use, REMOTE_ADDR is correct
    ip = request.headers.get("X-Forwarded-For", request.remote_addr)
    if ip and "," in ip:
        ip = ip.split(",")[0].strip()
    return jsonify({"ip": ip})


# ── Client registration ───────────────────────────────────────────────────────

@app.route("/api/register_client", methods=["POST"])
def api_register_client():
    token = request.headers.get("X-Token", "")
    if token != SECRET_TOKEN:
        abort(401)
    data = request.get_json(force=True, silent=True) or {}
    ip       = data.get("ip", request.remote_addr)
    hostname = data.get("hostname", "unknown")
    port     = int(data.get("port", AGENT_PORT))
    aid      = _agent_id(ip, hostname)
    with _agents_lock:
        _agents[aid] = {
            "agent_id":  aid,
            "ip":        ip,
            "hostname":  hostname,
            "port":      port,
            "last_seen": time.time(),
            "status":    "idle",
        }
    return jsonify({"registered": True, "agent_id": aid})


@app.route("/api/clients")
def api_clients():
    _prune_agents()
    now = time.time()
    with _agents_lock:
        clients = [
            {**v, "last_seen_ago": int(now - v["last_seen"])}
            for v in _agents.values()
        ]
    return jsonify({"clients": clients})


# ── Trigger scan on a client ──────────────────────────────────────────────────

@app.route("/api/scan_client/<agent_id>", methods=["POST"])
def api_scan_client(agent_id: str):
    result = _call_agent(agent_id, "POST", "/run")
    if "error" in result:
        return jsonify(result), 500
    # Reset any previously stored files for this agent
    with _client_files_lock:
        _client_files.pop(agent_id, None)
    return jsonify(result)


# ── Poll the client's scan log ────────────────────────────────────────────────

@app.route("/api/client_status/<agent_id>")
def api_client_status(agent_id: str):
    offset = int(request.args.get("offset", 0))
    result = _call_agent(agent_id, "GET", "/status")
    if "error" in result:
        return jsonify({"status": "error", "lines": [result["error"]], "error": result["error"]})
    lines = result.get("log", [])[offset:]
    return jsonify({
        "status": result.get("status", "unknown"),
        "lines":  lines,
        "error":  result.get("error", ""),
    })


# ── Receive uploaded PDF / JSON from the client agent ────────────────────────

@app.route("/api/client_upload/<agent_id>/<ftype>/<filename>", methods=["PUT"])
def api_client_upload(agent_id: str, ftype: str, filename: str):
    token = request.headers.get("X-Token", "")
    if token != SECRET_TOKEN:
        abort(401)

    # Sanitise filename
    filename = re.sub(r'[^A-Za-z0-9_\-.]', '_', os.path.basename(filename))
    save_path = OUTPUT_DIR / filename

    data = request.get_data()
    with open(save_path, "wb") as f:
        f.write(data)

    with _client_files_lock:
        if agent_id not in _client_files:
            _client_files[agent_id] = {}
        _client_files[agent_id][ftype] = str(save_path)

    return jsonify({"status": "ok", "bytes": len(data), "path": str(save_path)})


# ── Get scan result metadata ──────────────────────────────────────────────────

@app.route("/api/client_result/<agent_id>")
def api_client_result(agent_id: str):
    with _client_files_lock:
        files = _client_files.get(agent_id, {})

    if not files:
        # Files not uploaded yet — also check agent status
        status = _call_agent(agent_id, "GET", "/status")
        if status.get("status") == "error":
            return jsonify({"error": status.get("error", "Scan failed.")})
        return jsonify({"pending": True})

    pdf_path  = files.get("pdf", "")
    json_path = files.get("json", "")

    return jsonify({
        "pdf_name":  os.path.basename(pdf_path)  if pdf_path  else "",
        "json_name": os.path.basename(json_path) if json_path else "",
        "ok": True,
    })


# ── Download the result files ─────────────────────────────────────────────────

@app.route("/api/client_download/<agent_id>/pdf")
def download_client_pdf(agent_id: str):
    with _client_files_lock:
        path = _client_files.get(agent_id, {}).get("pdf")
    if not path or not os.path.isfile(path):
        return "No PDF available for this client yet.", 404
    return send_file(path, as_attachment=True,
                     download_name=os.path.basename(path),
                     mimetype="application/pdf")


@app.route("/api/client_download/<agent_id>/json")
def download_client_json(agent_id: str):
    with _client_files_lock:
        path = _client_files.get(agent_id, {}).get("json")
    if not path or not os.path.isfile(path):
        return "No JSON available for this client yet.", 404
    return send_file(path, as_attachment=True,
                     download_name=os.path.basename(path),
                     mimetype="application/json")


